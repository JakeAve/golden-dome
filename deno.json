{
  "tasks": {
    "check": "deno check sim/*.js sim/*.ts",
    "test": "deno task check && deno test sim/",
    "bench": "deno run sim/bench.ts",
    "serve": "deno run --allow-net --allow-read jsr:@std/http/file-server ."
  },
  "compilerOptions": { "checkJs": true, "lib": ["deno.ns", "esnext"] },
  "fmt": { "lineWidth": 200, "singleQuote": true }
}
